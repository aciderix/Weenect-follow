<?xml version="1.0" encoding="utf-8"?>
<!-- Données de santé et identifiants : ni sauvegarde cloud ni transfert d'appareil (Android 12+).
     Utiliser l'export de configuration chiffré pour changer de téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
